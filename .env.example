NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://sysadv:sysadv_dev@sysadv-postgres:5432/sysadv?schema=public
ACCESS_TOKEN_SECRET=change-this-access-token-secret-with-at-least-32-chars
REFRESH_TOKEN_SECRET=change-this-refresh-token-secret-with-at-least-32-chars
WEB_ORIGIN=http://localhost:9080
DOCUMENT_STORAGE_PATH=/data/documents
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
MAX_DOCUMENT_BYTES=20971520

# CNJ DataJud: configure locally; never commit the real credential
DATAJUD_API_KEY=

# Opcional: chave dedicada para criptografia dos segredos das fontes (>=32 chars).
SOURCE_ENCRYPTION_KEY=change-this-source-encryption-key-with-at-least-32-chars

# PJe-Calc
PJECALC_STORAGE_DIR=/data/pjecalc

# Porta web no host (mude se estiver reservada pelo Windows)
SYSADV_WEB_PORT=9080
# Cache descartavel: PostgreSQL permanece fonte oficial
DASHBOARD_CACHE_DIR=/data/dashboard-cache

# Integrações judiciais v0.9.2: BLOQUEADAS por padrão.
# Só liberar após parecer jurídico, conferência de contrato, aprovação interna e homologação.
# O DataJud é vedado para exploração comercial (Portaria CNJ 374/2026).
JUDICIAL_DATAJUD_NONCOMMERCIAL_ENABLED=false
# Exige contrato DJEN integral conferido e mapeamento da resposta documentado.
JUDICIAL_DJEN_CONTRACT_VALIDATED=false

# OBRIGATORIO antes de atualizar em ambiente real (nao usar senha padrao).
# SEED_ADMIN_PASSWORD=defina-uma-senha-unica-com-mais-de-32-caracteres
# IMPORTANTE: o docker-compose atual usa a credencial DB herdada do desenvolvimento.
# Rotacione as credenciais do PostgreSQL antes de armazenar dados reais de clientes.
# Para producao: rotacione PRIMEIRO a senha da role existente no PostgreSQL.
# Mantenha as duas variaveis coerentes; codifique caracteres reservados na URL.
# SYSADV_DB_PASSWORD=senha-forte-ja-aplicada-na-role-do-banco
# SYSADV_DATABASE_URL=postgresql://sysadv:<senha-url-encoded>@sysadv-postgres:5432/sysadv?schema=public
