model OfficeSettings {
  organizationId String @id
  timezone String @default("America/Sao_Paulo")
  defaultHourlyRateCents Int @default(0)
  officeEmail String?
  officePhone String?
  currency String @default("BRL")
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
}


// SysADV v0.10.1 - Motor de prazos. Datas juridicas armazenadas como DATE.
// Regras editaveis sao versionadas; uma versao utilizada nao deve ser alterada.
model DeadlineRule {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  version        Int
  label          String
  branch         String
  nature         String
  countMode      String
  quantity       Int
  endRoll        String
  recess         Boolean @default(false)
  doubleEligible Boolean @default(false)
  trigger        String
  sourceUrl      String
  caveat         String
  active         Boolean @default(true)
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deadlines      DeadlineCase[]
  @@unique([organizationId, code, version])
  @@index([organizationId, branch, active])
}

model CourtCalendarCoverage {
  id             String @id @default(cuid())
  organizationId String
  tribunalCode   String
  state          String
  city           String @default("")
  year           Int
  sourceUrl      String
  evidence       String
  verifiedAt     DateTime @default(now())
  verifiedById   String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, tribunalCode, state, city, year])
  @@index([organizationId, year])
}

model CourtSuspension {
  id             String @id @default(cuid())
  organizationId String
  tribunalCode   String
  state          String
  city           String @default("")
  from           DateTime @db.Date
  to             DateTime @db.Date
  reason         String
  evidence       String
  approvedById   String
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, from, to])
}

model DeadlineCase {
  id                 String @id @default(cuid())
  organizationId     String
  processId          String?
  createdById        String
  ruleId             String?
  ruleCode           String
  ruleVersion        Int
  ruleSnapshot       Json
  anchorDate         DateTime @db.Date
  anchorEvidence     String
  tribunalCode       String
  state              String
  city               String @default("")
  fileFormat         String
  doubleBasis        String @default("NONE")
  doubleJustification String?
  fixedDueAt         DateTime?
  fixedDueAtRaw      String?
  internalBusinessDays Int @default(2)
  legalDueOn         DateTime @db.Date
  internalDueOn      DateTime @db.Date
  status             String @default("PENDING_REVIEW")
  calendarVerified   Boolean @default(false)
  warnings           Json
  calculationHash    String
  reviewerId         String?
  reviewedAt         DateTime?
  reviewNotes        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process            LegalProcess? @relation(fields: [processId], references: [id], onDelete: SetNull)
  rule               DeadlineRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  alerts             DeadlineAlert[]
  @@index([organizationId, legalDueOn, status])
  @@index([organizationId, processId])
}

// Alerts stay stored; in-app feed reads only reviewed cases. No external sending in v0.10.1.
model DeadlineAlert {
  id             String @id @default(cuid())
  organizationId String
  deadlineId     String
  kind           String
  scheduledOn    DateTime @db.Date
  acknowledgedById String?
  acknowledgedAt DateTime?
  createdAt      DateTime @default(now())
  deadline       DeadlineCase @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([deadlineId, kind])
  @@index([organizationId, scheduledOn, acknowledgedAt])
}
