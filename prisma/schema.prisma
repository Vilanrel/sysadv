model FinancialPayment {
  id String @id @default(cuid())
  organizationId String
  entryId String
  createdById String
  idempotencyKey String
  amountCents Int
  paidOn DateTime @db.Date
  method String?
  reference String?
  notes String? @db.Text
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  entry FinancialEntry @relation(fields:[entryId],references:[id],onDelete:Restrict)
  creator User @relation("FinancialPaymentCreator",fields:[createdById],references:[id],onDelete:Restrict)
