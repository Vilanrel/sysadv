import { useCallback,useEffect,useMemo,useState } from 'react';
import { Link } from 'react-router-dom';
import { apiFetch } from '../auth/api';
import { useAuth } from '../auth/AuthProvider';

type Mode='day'|'week'|'month';
type Kind='EVENT'|'TASK'|'HOLIDAY'|'DEADLINE';
type Item={id:string;kind:Kind;at:string;title?:string;name?:string;type?:string;startsAt?:string;endsAt?:string|null;location?:string|null;meetingUrl?:string|null;notes?:string|null;process?:{id:string;npu:string}|null;responsible?:{id:string;name:string}|null;assignedTo?:{id:string;name:string}|null;active?:boolean};
type EventForm={title:string;type:string;startsAt:string;endsAt:string;responsibleId:string;processId:string;location:string;meetingUrl:string;notes:string};
const today=new Date();
const toDateInput=(d:Date)=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
const asLocalInput=(iso:string|null|undefined)=>iso?`${new Date(iso).getFullYear()}-${String(new Date(iso).getMonth()+1).padStart(2,'0')}-${String(new Date(iso).getDate()).padStart(2,'0')}T${String(new Date(iso).getHours()).padStart(2,'0')}:${String(new Date(iso).getMinutes()).padStart(2,'0')}`:'';
const startOfDay=(day:string)=>new Date(`${day}T00:00:00`);
function bounds(day:string,mode:Mode){const start=startOfDay(day);const end=new Date(start);
 if(mode==='month'){start.setDate(1);end.setMonth(start.getMonth()+1,0);}
 if(mode==='week'){const weekday=(start.getDay()+6)%7;start.setDate(start.getDate()-weekday);end.setTime(start.getTime());end.setDate(end.getDate()+6);}
 end.setHours(23,59,59,999);return {start,end};}
const newForm=(date:string):EventForm=>({title:'',type:'HEARING',startsAt:`${date}T09:00`,endsAt:'',responsibleId:'',processId:'',location:'',meetingUrl:'',notes:''});
const types:Record<string,string>={HEARING:'Audiência',MEETING:'Compromisso',DEADLINE:'Prazo',OTHER:'Outro',TASK:'Tarefa',HOLIDAY:'Feriado'};
export function AgendaPage(){
 const {has}=useAuth();const [day,setDay]=useState(toDateInput(today));const [mode,setMode]=useState<Mode>('month');const [items,setItems]=useState<Item[]>([]);
 const [error,setError]=useState('');const [notice,setNotice]=useState('');const [busy,setBusy]=useState(false);
 const [formOpen,setFormOpen]=useState(false);const [editingId,setEditingId]=useState<string|null>(null);const [form,setForm]=useState<EventForm>(newForm(toDateInput(today)));
 const [holidayOpen,setHolidayOpen]=useState(false);const [holiday,setHoliday]=useState({name:'',date:toDateInput(today),tribunalCode:'',state:'',city:''});
 const [users,setUsers]=useState<{id:string;name:string}[]>([]);const [processes,setProcesses]=useState<{id:string;npu:string}[]>([]);
 const range=useMemo(()=>bounds(day,mode),[day,mode]);
 const load=useCallback(async()=>{setError('');const qs=new URLSearchParams({from:range.start.toISOString(),to:range.end.toISOString()});try{const r=await apiFetch(`/agenda?${qs}`);const data=await r.json();if(!r.ok)throw new Error(data.error??'ERROR');setItems(data.items);}catch(e){setError(`Não foi possível carregar a agenda: ${e instanceof Error?e.message:'ERROR'}`);}},[range]);
 useEffect(()=>{void load()},[load]);
 useEffect(()=>{if(has('task.read'))void apiFetch('/tasks/assignees').then(async r=>{if(r.ok)setUsers(await r.json())});if(has('process.read'))void apiFetch('/processes').then(async r=>{if(r.ok)setProcesses(await r.json())});},[has]);
 function prevNext(steps:number){const base=startOfDay(day);if(mode==='month')base.setMonth(base.getMonth()+steps);else base.setDate(base.getDate()+steps*(mode==='week'?7:1));setDay(toDateInput(base));}
 function startNew(){setEditingId(null);setForm(newForm(day));setFormOpen(true);setError('');}
 function edit(item:Item){if(item.kind!=='EVENT'||!item.startsAt)return;setEditingId(item.id);setForm({title:item.title??'',type:item.type??'HEARING',startsAt:asLocalInput(item.startsAt),endsAt:asLocalInput(item.endsAt),processId:item.process?.id??'',responsibleId:item.responsible?.id??'',location:item.location??'',meetingUrl:item.meetingUrl??'',notes:item.notes??''});setFormOpen(true);}
 async function save(e:React.FormEvent){e.preventDefault();setBusy(true);setError('');try{const input={...form,startsAt:new Date(form.startsAt).toISOString(),endsAt:form.endsAt?new Date(form.endsAt).toISOString():null,processId:form.processId||null,responsibleId:form.responsibleId||null};const r=await apiFetch(editingId?`/agenda/events/${editingId}`:'/agenda/events',{method:editingId?'PATCH':'POST',body:JSON.stringify(input)});const data=await r.json();if(!r.ok)throw new Error(data.error??'ERROR');setFormOpen(false);setEditingId(null);setNotice('Compromisso salvo.');await load();}catch(e){setError(`Não foi possível salvar o evento: ${e instanceof Error?e.message:'ERROR'}`);}finally{setBusy(false);}}
 async function cancel(){if(!editingId||!window.confirm('Cancelar este evento da agenda?'))return;setBusy(true);const r=await apiFetch(`/agenda/events/${editingId}`,{method:'DELETE'});if(r.ok){setFormOpen(false);setEditingId(null);setNotice('Evento cancelado; histórico preservado.');await load();}else setError('Não foi possível cancelar o evento.');setBusy(false);}
 async function addHoliday(e:React.FormEvent){e.preventDefault();setBusy(true);setError('');try{const r=await apiFetch('/agenda/holidays',{method:'POST',body:JSON.stringify(holiday)});const data=await r.json();if(!r.ok)throw new Error(data.error??'ERROR');setHolidayOpen(false);setHoliday({name:'',date:day,tribunalCode:'',state:'',city:''});setNotice('Feriado cadastrado. Confira sua aplicação no calendário do tribunal.');await load();}catch(e){setError(`Não foi possível cadastrar feriado: ${e instanceof Error?e.message:'ERROR'}`);}finally{setBusy(false);}}
 const dayFor=(item:Item)=>item.kind==='HOLIDAY'||item.kind==='DEADLINE'?item.at.slice(0,10):toDateInput(new Date(item.at));
 const daysForMonth=useMemo(()=>{if(mode!=='month')return [];const start=new Date(range.start);const days=(start.getDay()+6)%7;start.setDate(start.getDate()-days);const cells=[];for(let i=0;i<42;i++){const d=new Date(start);d.setDate(start.getDate()+i);cells.push(d);}return cells;},[range,mode]);
 const counts=useMemo(()=>{const m=new Map<string,number>();for(const i of items){const k=dayFor(i);m.set(k,(m.get(k)??0)+1);}return m;},[items]);
 const grouped=useMemo(()=>{const m=new Map<string,Item[]>();for(const i of items){const k=dayFor(i);const list=m.get(k)??[];list.push(i);m.set(k,list);}return [...m.entries()].sort(([a],[b])=>a.localeCompare(b));},[items]);
 return <><div className="page-heading"><div><span className="eyebrow">Compromissos e prazos · RF-AGE</span><h1>Agenda jurídica</h1><p>Audiencias, compromissos, tarefas e feriados em uma visão única.</p></div><div className="actions">{has('calendar.manage')&&<button className="ghost" onClick={()=>setHolidayOpen(v=>!v)}>+ Feriado</button>}{has('calendar.write')&&<button className="primary" onClick={startNew}>+ Compromisso</button>}</div></div>
 {error&&<div className="alert" role="alert">{error}</div>}{notice&&<p className="notice-success" role="status">{notice}</p>}
 <section className="panel calendar-toolbar"><div className="actions"><button className="ghost" onClick={()=>prevNext(-1)} aria-label="Período anterior">‹</button><button className="ghost" onClick={()=>setDay(toDateInput(new Date()))}>Hoje</button><button className="ghost" onClick={()=>prevNext(1)} aria-label="Próximo período">›</button><strong>{range.start.toLocaleDateString('pt-BR',{day:'2-digit',month:'long',year:'numeric'})} — {range.end.toLocaleDateString('pt-BR',{day:'2-digit',month:'long',year:'numeric'})}</strong></div><div className="actions"><input type="date" aria-label="Selecionar data" value={day} onChange={e=>setDay(e.target.value)}/><select aria-label="Visualização da agenda" value={mode} onChange={e=>setMode(e.target.value as Mode)}><option value="day">Dia</option><option value="week">Semana</option><option value="month">Mês</option></select></div></section>
 {formOpen&&<section className="panel"><div className="panel-head"><h2>{editingId?'Alterar compromisso':'Novo compromisso'}</h2><button className="ghost" onClick={()=>setFormOpen(false)}>Fechar</button></div><form className="entity-form" onSubmit={e=>void save(e)}><label className="span-full">Título *<input required value={form.title} onChange={e=>setForm({...form,title:e.target.value})}/></label><label>Tipo<select value={form.type} onChange={e=>setForm({...form,type:e.target.value})}>{['HEARING','MEETING','DEADLINE','OTHER'].map(k=><option key={k} value={k}>{types[k]}</option>)}</select></label><label>Responsável<select value={form.responsibleId} onChange={e=>setForm({...form,responsibleId:e.target.value})}><option value="">Sem atribuição</option>{users.map(u=><option value={u.id} key={u.id}>{u.name}</option>)}</select></label><label>Início *<input type="datetime-local" required value={form.startsAt} onChange={e=>setForm({...form,startsAt:e.target.value})}/></label><label>Término<input type="datetime-local" value={form.endsAt} onChange={e=>setForm({...form,endsAt:e.target.value})}/></label><label>Processo<select value={form.processId} onChange={e=>setForm({...form,processId:e.target.value})}><option value="">Sem processo</option>{processes.map(p=><option value={p.id} key={p.id}>{p.npu}</option>)}</select></label><label>Local<input value={form.location} onChange={e=>setForm({...form,location:e.target.value})}/></label><label className="span-full">Link da reunião<input type="url" placeholder="https://" value={form.meetingUrl} onChange={e=>setForm({...form,meetingUrl:e.target.value})}/></label><label className="span-full">Orientações<textarea rows={3} value={form.notes} onChange={e=>setForm({...form,notes:e.target.value})}/></label><div className="actions span-full"><button className="primary" type="submit" disabled={busy}>Salvar</button>{editingId&&<button className="danger" type="button" disabled={busy} onClick={()=>void cancel()}>Cancelar evento</button>}</div></form></section>}
 {holidayOpen&&<section className="panel"><div className="panel-head"><h2>Feriado / suspensão</h2><button className="ghost" onClick={()=>setHolidayOpen(false)}>Fechar</button></div><form className="entity-form" onSubmit={e=>void addHoliday(e)}><label>Nome<input required minLength={3} value={holiday.name} onChange={e=>setHoliday({...holiday,name:e.target.value})}/></label><label>Data<input type="date" required value={holiday.date} onChange={e=>setHoliday({...holiday,date:e.target.value})}/></label><label>Tribunal<input placeholder="Ex.: TRT2" value={holiday.tribunalCode} onChange={e=>setHoliday({...holiday,tribunalCode:e.target.value})}/></label><label>UF<input maxLength={2} value={holiday.state} onChange={e=>setHoliday({...holiday,state:e.target.value.toUpperCase()})}/></label><label>Cidade<input value={holiday.city} onChange={e=>setHoliday({...holiday,city:e.target.value})}/></label><button className="primary" type="submit" disabled={busy}>Cadastrar feriado</button></form></section>}
 {mode==='month'&&<section className="panel"><div className="calendar-scroll" role="region" aria-label="Calendário mensal — role horizontalmente para consultar todos os dias" tabIndex={0}><div className="calendar-grid" aria-label="Calendário do mês">{['Seg','Ter','Qua','Qui','Sex','Sáb','Dom'].map(d=><div className="calendar-day-header" key={d}>{d}</div>)}{daysForMonth.map(d=>{const key=toDateInput(d);const inMonth=d.getMonth()===range.start.getMonth();return <button key={key} className={`calendar-cell ${inMonth?'':'off-month'} ${key===day?'focused':''}`} onClick={()=>{setDay(key);setMode('day')}}><strong>{d.getDate()}</strong>{(counts.get(key)??0)>0&&<small>{counts.get(key)} evento(s)</small>}</button>})}</div></div></section>}
 <section className="panel"><div className="panel-head"><div><h2>Compromissos do período</h2><p>{items.length} registro(s) entre eventos, tarefas e feriados.</p></div><button className="ghost" onClick={()=>void load()}>Atualizar</button></div>{grouped.length===0?<p className="muted">Sem compromissos ou prazos neste período.</p>:<div className="agenda-list">{grouped.map(([date,list])=><div className="agenda-day" key={date}><h3>{new Date(`${date}T12:00:00`).toLocaleDateString('pt-BR',{weekday:'long',day:'2-digit',month:'long'})}</h3>{list.map(item=><div className="agenda-row" key={`${item.kind}-${item.id}`}><span className={`agenda-tag agenda-${item.kind.toLowerCase()}`}>{item.kind==='TASK'?'Tarefa':item.kind==='HOLIDAY'?'Feriado':item.kind==='DEADLINE'?'Prazo fatal aprovado':types[item.type??'OTHER']}</span><span className="agenda-row-content"><strong>{item.kind==='HOLIDAY'?item.name:item.title}</strong><small>{item.kind!=='HOLIDAY'&&item.kind!=='DEADLINE'?new Date(item.at).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}):'Dia inteiro'} · {item.responsible?.name||item.assignedTo?.name||item.location||''}</small></span><span className="actions">{item.process&&<Link to={`/processes/${item.process.id}`}>Processo</Link>}{item.kind==='TASK'&&<Link to="/tasks">Tarefa</Link>}{item.kind==='DEADLINE'&&<Link to="/deadlines">Prazo</Link>}{item.kind==='EVENT'&&has('calendar.write')&&<button className="ghost" onClick={()=>edit(item)}>Editar</button>}</span></div>)}</div>)}</div>}</section>
 <p className="muted compact-meta">A agenda exibe os feriados cadastrados como referência. A contagem automática de prazos judiciais deve ser homologada por tribunal antes de qualquer utilização jurídica.</p>
 </>;
}
